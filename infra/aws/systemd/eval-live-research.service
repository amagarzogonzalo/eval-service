[Unit]
Description=eval-service research service E2E (Render)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eval
Group=eval
WorkingDirectory=/srv/eval-service
Environment=AWS_DEFAULT_REGION=eu-north-1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=EVAL_BIN=/srv/eval-service/target/release/eval
Environment=EVAL_STORE=/var/lib/eval-runs
Environment=EVAL_S3_URI=s3://eval-store-342940030437-eu-north-1/eval-runs
Environment=EVAL_RESEARCH_PYTHON=/srv/eval-venvs/research-agents/bin/python
Environment=EVAL_RESEARCH_REPO=/srv/targets/research-orchestration-agents
Environment=EVAL_ENV_FILE=/etc/eval/research.env
Environment=EVAL_OTEL_ENDPOINT=http://127.0.0.1:4328
EnvironmentFile=-/etc/eval/research-service.env
ExecStart=/usr/bin/env bash /srv/eval-service/integrations/research_agents/run_live_service.sh remote
TimeoutStartSec=1800
Nice=10
