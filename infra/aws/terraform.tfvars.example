# Copy to terraform.tfvars (gitignored) and fill in.
region = "eu-north-1"

# Your current public IP, /32. Never 0.0.0.0/0.
admin_cidr = "203.0.113.7/32"

# AWS Budget alerts (confirm the subscription email once).
alert_email = "you@example.com"

ssh_public_key_path = "~/.ssh/eval-runner-aws.pub"

instance_type = "t4g.large"
# Budgets alert and stop the instance at 100% of this value. The fixed
# floor (public IPv4 + EBS) is a few dollars/month; keep headroom.
budget_usd = "60"
# boot_volume_gb = 30

