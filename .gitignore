# Build artifacts
target/

# Local tooling (AWS CLI venv, Terraform binary)
.tools/

# Terraform state and plan files (never commit)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfplan
infra/**/tfplan
infra/**/terraform.tfvars
infra/**/crash.log
infra/**/*.log

# Python bytecode / caches
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Generated evaluation outputs (local history, never published)
eval-runs/
output/
dashboard/

# Local, machine-specific workspace registry
eval-workspace.local.toml

# Local watch runtime config/state and lock files
eval-watch/
eval-watch.toml
eval-watch.local.toml

# Secrets and local environment — never commit real credentials.
# `.env.example` files (if ever added) stay tracked via the negation below.
.env
.env.*
!.env.example
*.local.env
web/dist/
